# Copy to backend/.env for local development:  Copy-Item .env.example .env   (or: cp .env.example .env)

# "development" for local work. Anything else (or leaving it unset) means production,
# which refuses to start without strong secrets, a database URL and CORS origins.
APP_ENV=development

# Required in production: long random values (at least 32 characters), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# SQLite file under backend/instance/ by default in development.
DATABASE_URL=sqlite:///mechanic_pro.db
# PostgreSQL example (postgres:// and postgresql:// URLs are converted to the psycopg driver):
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/mechanic_pro

# Comma-separated frontend origins. Required in production; "*" is rejected.
# Development defaults to http://localhost:5173 and http://127.0.0.1:5173.
# Sessions use httpOnly cookies, so serve the frontend and the API from the same site
# (for example app.example.com and app.example.com/api, or api.example.com).
CORS_ORIGINS=

# Session lifetimes in minutes (defaults: 30-minute access token, 7-day refresh token).
JWT_ACCESS_MINUTES=30
JWT_REFRESH_MINUTES=10080

# Failed sign-ins allowed per client IP and per email (also applied to invitation and
# password-reset attempts per IP). Stored in the database, so it holds across restarts and processes.
LOGIN_RATE_LIMIT=10 per minute;50 per hour

# Number of reverse proxies / load balancers in front of the app, so the real client IP is used
# for rate limiting. Leave 0 when the app is reached directly.
TRUSTED_PROXY_COUNT=0

# Photos, videos and signatures.
#   local: saved on disk under backend/instance/uploads (or STORAGE_LOCAL_DIR). Fine for
#          development or a single server; not for serverless hosts, whose disks don't last.
#   s3:    any S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS S3, MinIO...).
#          Phones upload straight to the bucket with short-lived signed links. The bucket
#          stays private and needs a CORS rule for your site (see SETUP.md, File storage).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=
# Needed when STORAGE_BACKEND=s3:
S3_BUCKET=
# R2: https://<account-id>.r2.cloudflarestorage.com   B2: https://s3.<region>.backblazeb2.com
# Leave empty for AWS S3.
S3_ENDPOINT_URL=
# "auto" for R2; the bucket's region for B2 and AWS (e.g. us-west-004, eu-west-1).
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Upload limits. Photos are also shrunk on the phone (to 1600 px) before upload.
MAX_PHOTO_MB=10
MAX_VIDEO_MB=50
MAX_DOCUMENT_MB=25
MAX_VIDEO_SECONDS=60

# Taking payment for plans. Leave unset to use the default: "test" in development (the app's own
# checkout with a test card, no real money) and "none" in production (free trials only, until a
# real payment provider is connected). "test" is refused in production.
# BILLING_PROVIDER=

# The public https:// address of the web app; links in emails point here. Required in production.
# Development defaults to the first CORS origin (http://localhost:5173).
APP_URL=

# Email. "log" (the development default) writes every email to the server log instead of sending it;
# "smtp" sends through your email provider and is required in production. See SETUP.md, Email.
# EMAIL_BACKEND=log
# EMAIL_FROM=MechanicPro <no-reply@yourdomain.com>
# Resend: smtp.resend.com, port 587, username "resend", password = your API key.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# starttls (port 587), ssl (port 465) or none
# SMTP_SECURITY=starttls

# Verification and password-reset emails one address can be sent, and "Try the demo" copies one
# IP address can start.
EMAIL_RATE_LIMIT=1 per minute;5 per hour
DEMO_RATE_LIMIT=10 per hour

# Turns on GET /api/cron/daily (header "Authorization: Bearer <CRON_SECRET>") for a daily scheduler.
# Leave empty to run the flask purge-* commands from cron instead. See SETUP.md, Daily clean-up.
CRON_SECRET=
